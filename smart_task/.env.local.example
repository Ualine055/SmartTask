# ---------------------------------------------------------------------------
# Firebase Web App config  (Project settings -> General -> Your apps -> Web app)
# These are public by design: security is enforced by firestore.rules.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin / service account  (Project settings -> Service accounts ->
# "Generate new private key").  SERVER ONLY - never expose these.
# Keep the \n escapes in the private key exactly as they appear in the JSON.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Email reminders (https://resend.com - free tier)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender. onboarding@resend.dev works for testing but can
# only deliver to the email address that owns the Resend account.
REMINDER_FROM_EMAIL="SmartTask <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Shared secret protecting /api/cron/reminders. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
CRON_SECRET=

# Used in reminder emails to link back to the task.
NEXT_PUBLIC_APP_URL=http://localhost:3000
