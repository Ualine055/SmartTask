{
  "name": "smart_task",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project smarttask-rules-test \"node --test tests/rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-smarttask",
    "seed:emulator": "node scripts/seed.mjs",
    "import:key": "node scripts/import-service-account.mjs",
    "check:email": "node --env-file=.env.local scripts/check-email.mjs",
    "remind": "node --env-file=.env.local scripts/send-reminders.mjs",
    "remind:dry": "node --env-file=.env.local scripts/send-reminders.mjs --dry"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^15.30.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
